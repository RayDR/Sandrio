{
  "name": "sanrio-store",
  "version": "1.0.0",
  "description": "Premium Sanrio Online Store - Multi-language, Fully Configurable, Production-Ready",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build --workspaces",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "sanrio",
    "ecommerce",
    "shopping",
    "online-store",
    "react",
    "node",
    "multilingual",
    "configurable"
  ],
  "author": "Sanrio Store Team",
  "license": "MIT"
}
